# =========================
# Unreal Engine
# =========================

# Ignore generated folders
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# Ignore plugin generated folders
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Ignore build outputs
Build/*
!Build/*/
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Ignore map build data
*_BuiltData.uasset

# =========================
# IDE / Editor files
# =========================

# Visual Studio
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Rider / JetBrains
.idea/
*.DotSettings.user

# VS Code
.vscode/

# Xcode (Mac)
*.xcodeproj
*.xcworkspace

# =========================
# OS junk
# =========================

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# Linux
*~

# =========================
# Logs & temp files
# =========================
*.log
*.tmp
*.cache

# =========================
# Compiled / binary stuff
# =========================
*.o
*.obj
*.so
*.dll
*.dylib
*.lib
*.exe
*.out
*.app

# =========================
# Optional: source art
# =========================
# Uncomment if you don't want raw assets in repo
# SourceArt/

# =========================
# Keep important files
# =========================

# Keep config, content, and source
!Config/
!Content/
!Source/

# Keep uproject file
!*.uproject